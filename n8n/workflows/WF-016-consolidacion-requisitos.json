{
  "id": "CernoIAProdWF016",
  "name": "[CernoIA PROD] WF-016 — Consolidación de requisitos por oportunidad",
  "nodes": [
    {
      "parameters": {},
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        -640,
        0
      ],
      "id": "16000000-0000-4000-8000-000000000001",
      "name": "Inicio Manual WF-016"
    },
    {
      "parameters": {
        "workflowInputs": {
          "values": [
            {
              "name": "organization_id"
            },
            {
              "name": "requested_by_user_id"
            },
